# =================================================================
# Banking Ledger Backend - Environment Configuration Template
# =================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Populate required values for your deployment environment.
# 3. NEVER commit .env with real secrets to version control.
# =================================================================

# =================================================================
# [REQUIRED] CORE PRODUCTION CONFIGURATION
# =================================================================

# Node environment mode (production | development | test)
NODE_ENV=production

# Server listening port (In cloud PaaS like Render/Railway/Heroku, this is injected automatically)
PORT=3000

# Full MongoDB Atlas connection URI with TLS and replica set configuration
# Format: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/backend-ledger?retryWrites=true&w=majority

# Strong cryptographic secret for signing and verifying JWT tokens (minimum 32-64 random characters)
# Generate with: openssl rand -base64 48
JWT_SECRET=your_long_cryptographically_secure_random_jwt_secret_here

# Allowed Frontend URL(s) for CORS and credential handling
# Single origin or comma-separated list of origins (e.g., https://app.yourdomain.com,https://admin.yourdomain.com)
FRONTEND_URL=https://your-frontend-domain.com

# =================================================================
# [PRODUCTION ONLY] REVERSE PROXY & HOSTING CONFIGURATION
# =================================================================

# Trust reverse proxy headers (X-Forwarded-For, X-Forwarded-Proto)
# REQUIRED if deployed behind Nginx, Cloudflare, Render, AWS ALB, or Heroku.
# Set to 'true' or '1' to correctly capture client IP for rate limiting and audit trail.
# Set to 'false' if running directly exposed to the internet.
TRUST_PROXY=true

# =================================================================
# [OPTIONAL] OBSERVABILITY & STRUCTURED LOGGING
# =================================================================

# Minimum logging severity level (DEBUG | INFO | WARN | ERROR)
LOG_LEVEL=INFO

# Latency threshold in milliseconds before triggering a SLOW_REQUEST warning in logs
SLOW_REQUEST_THRESHOLD_MS=1000

# =================================================================
# [OPTIONAL] RATE LIMITING BOUNDS (Sensible defaults built-in)
# =================================================================

# Authentication endpoints limiter (/api/auth/*)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

# Transaction creation limiter (/api/transactions)
RATE_LIMIT_TX_WINDOW_MS=60000
RATE_LIMIT_TX_MAX=60

# Admin endpoints limiter (/api/admin/*)
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=120

# Global API limiter (/api/*)
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=1000

# =================================================================
# [OPTIONAL] EMAIL NOTIFICATION SERVICE (OAuth2 / Nodemailer)
# =================================================================
# Optional: If omitted or unconfigured, transaction notifications
# log a warning and continue without failing financial execution.
CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
CLIENT_SECRET=your_oauth_client_secret
REFRESH_TOKEN=your_oauth_refresh_token
EMAIL_USER=notifications@yourdomain.com

# =================================================================
# [DEVELOPMENT ONLY] LOCAL MACHINE OVERRIDES
# =================================================================
# For local dev without HTTPS, set:
# NODE_ENV=development
# FRONTEND_URL=http://localhost:5173
# TRUST_PROXY=false
