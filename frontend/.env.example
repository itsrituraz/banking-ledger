# =================================================================
# Banking Ledger Frontend - Environment Configuration Template
# =================================================================
# Note: Variables prefixed with VITE_ are embedded into the client bundle at build time.
# NEVER put backend secrets, database credentials, or private keys in this file.
# =================================================================

# Backend API Base URL (including /api prefix)
# Development default: http://localhost:3000/api
# Production example: https://api.yourdomain.com/api
VITE_API_BASE_URL=http://localhost:3000/api
